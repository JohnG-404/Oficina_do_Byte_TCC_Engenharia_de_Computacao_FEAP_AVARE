--- !u!114 &1511740720
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1511740718}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41ec0dab9518b3a448b480c50c22ada5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HudLicao
  barraDeVida: {fileID: 60640111}
  playerHealth: {fileID: 628995086}
  dialogueManager: {fileID: 1640519936}
  falasDano:
  - "Opa, voc\xEA tomou dano. A vida caiu pra {vida}..."
  - "...mas a barra continua cheia. A vida mudou, mas ningu\xE9m avisou a tela."
  - "Num jogo, a tela s\xF3 mostra um dado. Ela precisa ser avisada toda vez que
    esse dado muda. Monte esse aviso."
  falasFechamento:
  - Pronto. Agora toda vez que a vida muda, o evento avisa a barra e ela se redesenha
    sozinha.
  textoVidaAtual: vidaAtual = {vida}
  textoBarraParada: a barra continua mostrando {barra}
  textoBarraConectada: a barra acompanha a vida
  encaixes:
  - pecaCorreta: vidaAtual
    dicaCodigo: int ___ = 3;
    legenda: PlayerHealth
    bloco: o dado e o evento
  - pecaCorreta: OnHealthChanged
    dicaCodigo: event Action<int, int> ___;
    legenda: PlayerHealth
    bloco: o dado e o evento
  - pecaCorreta: AtualizarQuadrados
    dicaCodigo: void ___(int vida, int max)
    legenda: HUD
    bloco: a tela
  pecas:
  - nome: AtualizarQuadrados
    descricao: A tela ouvindo o evento. Recebe a vida nova e redesenha os quadrados.
    icone: {fileID: 21300000, guid: bce34d4135708c5449b9ff6abc29be4e, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "M\xC9TODO"
    corCategoria: {r: 0.6392157, g: 0.9019608, b: 0.20784314, a: 1}
    subtitulo: redesenha a barra
  - nome: Start
    descricao: "Roda uma vez s\xF3, quando a fase come\xE7a."
    icone: {fileID: 21300000, guid: 7526b77a00a003f4190305f1dfe044fd, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "M\xC9TODO"
    corCategoria: {r: 0.6392157, g: 0.9019608, b: 0.20784314, a: 1}
    subtitulo: roda uma vez
  - nome: vidaAtual
    descricao: "O dado. Um n\xFAmero guardado no PlayerHealth."
    icone: {fileID: 21300000, guid: 987889abd629f6a49b241093c397619a, type: 3}
    moldura: {fileID: 21300000, guid: a1a8c8391fdfd5143b76a836d38fe74d, type: 3}
    categoria: CAMPO
    corCategoria: {r: 0.55, g: 0.58, b: 1, a: 1}
    subtitulo: "o n\xFAmero da vida"
  - nome: Destroy(barra)
    descricao: Apaga o objeto da barra de vida da cena.
    icone: {fileID: 21300000, guid: 8d8a622a3c776db4ca6fd1291862278b, type: 3}
    moldura: {fileID: 21300000, guid: 4297619242d4d5148bb2ab9a75bdee77, type: 3}
    categoria: "M\xC9TODO"
    corCategoria: {r: 0.23921569, g: 0.64705884, b: 1, a: 1}
    subtitulo: apaga a barra
  - nome: OnHealthChanged
    descricao: O evento. Quando a vida muda, ele avisa quem estiver ouvindo.
    icone: {fileID: 21300000, guid: b8fdfb602a785f94c9cdf86ccc5a3641, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: EVENTO
    corCategoria: {r: 0.95686275, g: 0.44705883, b: 0.7137255, a: 1}
    subtitulo: avisa quem ouve
  textosPuzzle:
    fase: "Fase Intera\xE7\xE3o e Vida"
    etapa: Barra de vida
    aba: HUD
    comentario: // quando a vida muda, a barra tem que ser avisada
    barraParada: barra parada
    barraConectada: barra conectada
    textoVida: vidaAtual = {vida}
    textoBarraParada: a barra continua mostrando {barra}
    textoBarraConectada: "a barra mostra {vida}, igual \xE0 vida"
    objetivo: a barra muda junto com a vida
    progressoSub: "Pe\xE7a errada recome\xE7a o puzzle."
    instrucao: "Arraste cada pe\xE7a at\xE9 o encaixe certo. Passe o mouse numa pe\xE7a
      pra ler aqui o que ela faz."
    descricaoTitulo: Dado, evento, tela
    descricaoPadrao: "O dado muda, o evento avisa, a tela redesenha. A barra s\xF3
      mostra a vida nova se algu\xE9m avisar ela."
    erroTitulo: "Essa pe\xE7a n\xE3o entra a\xED"
    erroTexto: "O puzzle recome\xE7ou. Leia a descri\xE7\xE3o das pe\xE7as e tente
      de novo."
  tituloCodigo: "C\xF3digo montado \xB7 HUD"
  codigoMontado: '<color=#8B95A7>// PlayerHealth: o dado muda e o evento avisa</color>

    <color=#EF4B4B>vidaAtual</color>
    -= dano;

    <color=#EF4B4B>OnHealthChanged</color>?.Invoke(<color=#EF4B4B>vidaAtual</color>,
    vidaMax);


    <color=#8B95A7>// HUD: a tela ouve o evento</color>

    playerHealth.<color=#EF4B4B>OnHealthChanged</color>
    += <color=#EF4B4B>AtualizarQuadrados</color>;'
  segundosCodigo: 8
  ordemAvisos: 60
  ordemPuzzle: 70
  objetivoLicao: 'Monte o aviso: dado, evento, tela'
  dicaObjetivoLicao: "A barra n\xE3o sabe que a vida mudou."
