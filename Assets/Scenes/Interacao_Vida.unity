  m_EditorClassIdentifier: Assembly-CSharp::InteracaoLevelFlow
  nextSceneName: Tutorial_Anim
  delayBeforeNextScene: 1.5
  dialogueManager: {fileID: 1640519936}
  introDialogue:
  - "Agora um upgrade: a mesma Intera\xE7\xE3o, s\xF3 que com vida em jogo."
  - "Repare nos quadrados no topo da tela: \xE9 a sua vida, um quadrado por ponto."
  - "As consequ\xEAncias agora tamb\xE9m podem curar ou machucar. Armadilhas causam
    dano, itens de cura recuperam. E se a vida zerar, a fase recome\xE7a."
  - "Configure tudo como antes, escolhendo A\xE7\xE3o e Consequ\xEAncia. Mas aten\xE7\xE3o:
    at\xE9 um item de cura pode ser configurado pra causar dano. Confira antes de
    salvar!"
  firstConfigHint: "Boa! Agora vai l\xE1 testar."
  firstDoorHint: "Show! Essa combina\xE7\xE3o funcionou."
  firstRestartHint: "N\xE3o foi dessa vez. Vamos tentar de novo!"
  firstDamageHint: Ai! Cada armadilha tira vida. Fica de olho nos quadrados.
  firstHealHint: Vida recuperada!
  restartHintDelay: 0.8
  completeUI: {fileID: 1663126848}
  playerHealth: {fileID: 0}
  gameOverUI: {fileID: 1511740719}
