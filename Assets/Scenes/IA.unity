  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleControl
  flowManager: {fileID: 0}
  listener: {fileID: 1969350939}
  tituloCodigo: "C\xF3digo montado \xB7 Transi\xE7\xF5es"
  codigoMontado: "float d = Vector2.Distance(transform.position, alvo.position);\nswitch
    (estado)\n{\n    case Estado.Patrulhar:\n        if (<color=#F5C542><noparse>d
    < raioVisao</noparse></color>) MudarEstado(Estado.Perseguir);\n        break;\n   
    case Estado.Perseguir:\n        if (<color=#F5C542><noparse>d > raioPerder</noparse></color>)
    MudarEstado(Estado.Patrulhar);\n        else if (<color=#F5C542><noparse>d <
    alcance</noparse></color>) MudarEstado(Estado.Atacar);\n        break;\n    case
    Estado.Atacar:\n        if (<color=#F5C542><noparse>d > alcance</noparse></color>)
    MudarEstado(Estado.Perseguir);\n        break;\n}"
  segundosCodigo: 8
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
  totalPieces: 4
  puzzle: {fileID: 400366714}
