  tituloCodigo: "C\xF3digo montado \xB7 Estados"
  codigoMontado: "switch (estado)\n{\n    case Estado.Patrulhar: velocidadeDesejadaX
    = <color=#F5C542><noparse>IrEntre()</noparse></color>; break;\n    case Estado.Perseguir:
    velocidadeDesejadaX = <color=#F5C542><noparse>MoverAte(alvo)</noparse></color>;
    break;\n    case Estado.Atacar: velocidadeDesejadaX = 0; <color=#F5C542><noparse>CausarDano()</noparse></color>;
    break;   <color=#8C9AB5>// TakeDamage</color>\n}\nrb.linearVelocity = new Vector2(velocidadeDesejadaX,
    rb.linearVelocity.y);"
  segundosCodigo: 8
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
  totalPieces: 3
