  listener: {fileID: 1969350939}
  tituloCodigo: "C\xF3digo montado \xB7 Linha de vis\xE3o"
  codigoMontado: 'float d = Vector2.Distance(transform.position, alvo.position);

    Vector2
    direcao = (Vector2)alvo.position - olho;

    RaycastHit2D hit = <color=#F5C542><noparse>Physics2D.Raycast</noparse></color>(olho,
    direcao.normalized, direcao.magnitude, obstaculos);

    bool ve = <noparse>d
    < raioVisao</noparse> && hit.collider == null;   <color=#8C9AB5>// nada no meio
    do caminho</color>


    if (estado == Estado.Patrulhar && ve) MudarEstado(Estado.Perseguir);'
  segundosCodigo: 8
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
  totalPieces: 1
