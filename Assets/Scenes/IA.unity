  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetivoFase
  etapas:
  - titulo: Monte os Estados do guarda
    dica: "Sem c\xE9rebro, ele fica parado."
  - titulo: Passe na frente do guarda
    dica: "Veja se ele percebe voc\xEA."
  - titulo: "Monte as Transi\xE7\xF5es"
    dica: Falta a regra que diz quando trocar de estado.
  - titulo: "Fique atr\xE1s da parede"
    dica: "Veja se o guarda enxerga atrav\xE9s dela."
  - titulo: Troque a regra 1 por Raycast
    dica: "Ele precisa ver voc\xEA, n\xE3o s\xF3 estar perto."
  - titulo: "Chegue \xE0 sa\xEDda sem o guarda te ver"
    dica: "A passarela bloqueia a linha de vis\xE3o."
  segundosGrande: 3.5
  segundosFade: 0.25
