  m_Script: {fileID: 11500000, guid: 608c404fc8356e445bdffbbde3c7eb9c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InfiniteCodeScroller
  snippets:
  - "<color=#4A5570><pos=4>  1</color><pos=80><color=#6B7A99>// F\xCDSICA \xB7 andar
    (AplicacaoPlayerController.cs)</color>\n<color=#4A5570><pos=4>  2</color><pos=80><color=#9B7BF0>float</color>
    moveInput =\n<pos=80>    InputManager.Instance.MoveAction\n<pos=80>    .ReadValue<<color=#9B7BF0>float</color>>();\n<color=#4A5570><pos=4> 
    3</color><pos=80>rb.linearVelocity =\n<pos=80>    <color=#9B7BF0>new</color>
    <color=#5FD4E8>Vector2</color>(moveInput * velocidade,\n<pos=80>    rb.linearVelocity.y);"
  - "<color=#4A5570><pos=4>  5</color><pos=80><color=#6B7A99>// F\xCDSICA \xB7 pular
    (coyote time + buffer)</color>\n<color=#4A5570><pos=4>  6</color><pos=80><color=#9B7BF0>if</color>
    (jumpConsumedSinceGrounded\n<pos=80>    || jumpBufferTimer <= <color=#F5C542>0f</color>
    || coyoteTimer <= <color=#F5C542>0f</color>)\n<color=#4A5570><pos=4>  7</color><pos=80>   
    <color=#9B7BF0>return</color>;\n<color=#4A5570><pos=4>  8</color><pos=80>jumpConsumedSinceGrounded
    = <color=#9B7BF0>true</color>;\n<color=#4A5570><pos=4>  9</color><pos=80>rb.linearVelocity
    =\n<pos=80>    <color=#9B7BF0>new</color> <color=#5FD4E8>Vector2</color>(rb.linearVelocity.x,
    forcaPulo);"
  - "<color=#4A5570><pos=4> 11</color><pos=80><color=#6B7A99>// F\xCDSICA \xB7 cair
    mais r\xE1pido do que sobe</color>\n<color=#4A5570><pos=4> 12</color><pos=80><color=#9B7BF0>if</color>
    (rb.linearVelocity.y < <color=#F5C542>0f</color>)\n<color=#4A5570><pos=4> 13</color><pos=80>   
    rb.gravityScale =\n<pos=80>        gravidadeBase * multiplicadorQueda;\n<color=#4A5570><pos=4>
    14</color><pos=80><color=#9B7BF0>else</color> <color=#9B7BF0>if</color> (rb.linearVelocity.y
    > <color=#F5C542>0f</color> && !<color=#5FD4E8>JumpHeld</color>())\n<color=#4A5570><pos=4>
    15</color><pos=80>    rb.gravityScale =\n<pos=80>        gravidadeBase * multiplicadorPuloCurto;"
  - "<color=#4A5570><pos=4> 17</color><pos=80><color=#6B7A99>// F\xCDSICA \xB7 o
    ch\xE3o \xE9 um Collider2D</color>\n<color=#4A5570><pos=4> 18</color><pos=80>IsGrounded
    = Time.time >= ignorarChaoAte\n<pos=80>    && rb.<color=#5FD4E8>IsTouching</color>(filtroChao);"
  - "<color=#4A5570><pos=4> 20</color><pos=80><color=#6B7A99>// INTERA\xC7\xC3O \xB7
    chegar perto do item</color>\n<pos=80><color=#6B7A99>// (ItemProximityZone.cs)</color>\n<color=#4A5570><pos=4>
    21</color><pos=80><color=#9B7BF0>private</color> <color=#9B7BF0>void</color>
    <color=#5FD4E8>OnTriggerEnter2D</color>(Collider2D other)\n<color=#4A5570><pos=4>
    22</color><pos=80>{\n<color=#4A5570><pos=4> 23</color><pos=80>    <color=#9B7BF0>if</color>
    (owner == <color=#9B7BF0>null</color>\n<pos=80>        || !InteractableItem.<color=#5FD4E8>IsPlayer</color>(other))\n<color=#4A5570><pos=4>
    24</color><pos=80>    {\n<color=#4A5570><pos=4> 25</color><pos=80>        <color=#9B7BF0>return</color>;\n<color=#4A5570><pos=4>
    26</color><pos=80>    }\n<color=#4A5570><pos=4> 27</color><pos=80>    owner.<color=#5FD4E8>HandleProximityEnter</color>(other);\n<color=#4A5570><pos=4>
    28</color><pos=80>}"
  - "<color=#4A5570><pos=4> 30</color><pos=80><color=#6B7A99>// INTERA\xC7\xC3O \xB7
    quem encostou \xE9 o jogador?</color>\n<color=#4A5570><pos=4> 31</color><pos=80><color=#9B7BF0>if</color>
    (other.<color=#5FD4E8>CompareTag</color>(PlayerTag))\n<color=#4A5570><pos=4>
    32</color><pos=80>    <color=#9B7BF0>return</color> <color=#9B7BF0>true</color>;"
  - "<color=#4A5570><pos=4> 34</color><pos=80><color=#6B7A99>// INTERA\xC7\xC3O \xB7
    vida \u2192 evento \u2192 HUD</color>\n<pos=80><color=#6B7A99>// (PlayerHealth.cs)</color>\n<color=#4A5570><pos=4>
    35</color><pos=80>CurrentHealth = Mathf.<color=#5FD4E8>Clamp</color>(CurrentHealth
    - amount,\n<pos=80>    <color=#F5C542>0</color>, maxHealth);\n<color=#4A5570><pos=4>
    36</color><pos=80>OnHealthChanged?.<color=#5FD4E8>Invoke</color>(CurrentHealth,
    maxHealth);\n<color=#4A5570><pos=4> 37</color><pos=80><color=#9B7BF0>if</color>
    (CurrentHealth <= <color=#F5C542>0</color>)\n<color=#4A5570><pos=4> 38</color><pos=80>{\n<color=#4A5570><pos=4>
    39</color><pos=80>    IsDead = <color=#9B7BF0>true</color>;\n<color=#4A5570><pos=4>
    40</color><pos=80>    OnDeath?.<color=#5FD4E8>Invoke</color>();\n<color=#4A5570><pos=4>
    41</color><pos=80>}"
  - "<color=#4A5570><pos=4> 43</color><pos=80><color=#6B7A99>// ANIMA\xC7\xC3O \xB7
    f\xEDsica \u2192 Animator</color>\n<pos=80><color=#6B7A99>// (AnimacaoPlayerFisica.cs)</color>\n<color=#4A5570><pos=4>
    44</color><pos=80>animator.<color=#5FD4E8>SetFloat</color>(hashVelocidadeX,\n<pos=80>   
    Mathf.<color=#5FD4E8>Abs</color>(rb.linearVelocity.x));\n<color=#4A5570><pos=4>
    45</color><pos=80>animator.<color=#5FD4E8>SetBool</color>(hashNoChao, IsGrounded);"
  - "<color=#4A5570><pos=4> 47</color><pos=80><color=#6B7A99>// ANIMA\xC7\xC3O \xB7
    virar o sprite pro lado certo</color>\n<color=#4A5570><pos=4> 48</color><pos=80><color=#9B7BF0>float</color>
    vx = rb.linearVelocity.x;\n<color=#4A5570><pos=4> 49</color><pos=80><color=#9B7BF0>if</color>
    (vx > LimiarParado) spriteRenderer.flipX =\n<pos=80>    <color=#9B7BF0>false</color>;\n<color=#4A5570><pos=4>
    50</color><pos=80><color=#9B7BF0>else</color> <color=#9B7BF0>if</color> (vx <
    -LimiarParado) spriteRenderer.flipX =\n<pos=80>    <color=#9B7BF0>true</color>;"
  - "<color=#4A5570><pos=4> 52</color><pos=80><color=#6B7A99>// IA \xB7 m\xE1quina
    de estados do guarda (GuardaIA.cs)</color>\n<color=#4A5570><pos=4> 53</color><pos=80><color=#9B7BF0>switch</color>
    (estado)\n<color=#4A5570><pos=4> 54</color><pos=80>{\n<color=#4A5570><pos=4>
    55</color><pos=80>    <color=#9B7BF0>case</color> Estado.Patrulhar:\n<color=#4A5570><pos=4>
    56</color><pos=80>        velocidadeDesejadaX = <color=#5FD4E8>IrEntre</color>();\n<color=#4A5570><pos=4>
    57</color><pos=80>        <color=#9B7BF0>break</color>;\n<color=#4A5570><pos=4>
    58</color><pos=80>    <color=#9B7BF0>case</color> Estado.Perseguir:\n<color=#4A5570><pos=4>
    59</color><pos=80>        velocidadeDesejadaX = <color=#5FD4E8>MoverAte</color>(alvo);\n<color=#4A5570><pos=4>
    60</color><pos=80>        <color=#9B7BF0>break</color>;\n<color=#4A5570><pos=4>
    61</color><pos=80>}"
  - "<color=#4A5570><pos=4> 63</color><pos=80><color=#6B7A99>// IA \xB7 transi\xE7\xE3o
    Perseguir \u2192 Atacar</color>\n<color=#4A5570><pos=4> 64</color><pos=80><color=#9B7BF0>else</color>
    <color=#9B7BF0>if</color> (<color=#5FD4E8>DistanciaAte</color>(alvo) < alcance)\n<color=#4A5570><pos=4>
    65</color><pos=80>    <color=#5FD4E8>MudarEstado</color>(Estado.Atacar);"
  - "<color=#4A5570><pos=4> 67</color><pos=80><color=#6B7A99>// IA \xB7 vis\xE3o
    com Raycast (IAVisao.cs)</color>\n<color=#4A5570><pos=4> 68</color><pos=80><color=#9B7BF0>return</color>
    <color=#5FD4E8>DistanciaAte</color>(t) < raioVisao\n<pos=80>    && <color=#5FD4E8>TemLinhaDeVisao</color>(t);\n<color=#4A5570><pos=4>
    69</color><pos=80>RaycastHit2D[] hits = Physics2D.<color=#5FD4E8>RaycastAll</color>(origem,\n<pos=80>   
    delta / distancia, distancia, obstaculos);"
  - "<color=#4A5570><pos=4> 71</color><pos=80><color=#6B7A99>// C\xC2MERA \xB7 seguir
    o jogador (CameraFollow.cs)</color>\n<color=#4A5570><pos=4> 72</color><pos=80>Vector3
    smoothed =\n<pos=80>    Vector3.<color=#5FD4E8>SmoothDamp</color>(transform.position,
    desired,\n<pos=80>    <color=#9B7BF0>ref</color> velocity, smoothTime, maxSpeed);"
