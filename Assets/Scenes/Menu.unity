  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreditosUI
  desenvolvimento: "Guilherme Monteiro da Luz, Jo\xE3o Gabriel Pereira Cardozo"
  orientacao: Nicolas Antonio Messias dos Santos Colloca
  instituicao: "FEAP Avar\xE9"
  modelo: "// Oficina do Byte \xB7 TCC 2026\npublic class Creditos : MonoBehaviour\n{\n   
    // Quem fez\n    string[] desenvolvedores =\n    {\n        \"Guilherme Monteiro
    da Luz\",\n        \"Jo\xE3o Gabriel Pereira Cardozo\",\n    };\n    string orientador
    = \"{orientacao}\";\n\n    // Faculdade de Engenharia e Administra\xE7\xE3o Paulista\n   
    string instituicao = \"{instituicao}\";\n    string curso       = \"Engenharia
    de Computa\xE7\xE3o\";\n\n    // O que voc\xEA aprende jogando\n    string[]
    fisica    = { \"Rigidbody2D\", \"Collider2D\", \"Pulo\" };\n    string[] interacao
    = { \"OnTriggerEnter2D\", \"Is Trigger\", \"Vida\" };\n    string[] animacao 
    = { \"Animation Clip\", \"FPS\", \"Animator\" };\n    string[] ia        = {
    \"M\xE1quina de estados\", \"Raycast\" };\n\n    // Feito com\n    string motor 
    = \"Unity 6 \xB7 URP 2D\";\n    string fontes = \"Baloo 2 \xB7 Nunito \xB7 JetBrains
    Mono\";\n\n    void Start() => Debug.Log(\"Obrigado por jogar!\");\n}"
  painel: {fileID: 1453409551}
  codigo: {fileID: 1182232707}
  numeros: {fileID: 1177235941}
  rolagem: {fileID: 2128966459}
  botaoFechar: {fileID: 1845174855}
  velocidadeTeclas: 0.9
