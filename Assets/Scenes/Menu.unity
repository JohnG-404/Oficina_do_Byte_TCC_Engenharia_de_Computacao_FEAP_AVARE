  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#5D6B8A>// Oficina do Byte \xB7 TCC 2026</color>\n<color=#C792EA>public</color>
    <color=#C792EA>class</color> <color=#5FD4E8>Creditos</color> : <color=#5FD4E8>MonoBehaviour</color>\n{\n<color=#5D6B8A>   
    // Quem fez</color>\n    <color=#C792EA>string</color>[] desenvolvedores =\n   
    {\n        <color=#F5C542>\"Guilherme Monteiro da Luz\"</color>,\n        <color=#F5C542>\"Jo\xE3o
    Gabriel Pereira Cardozo\"</color>,\n    };\n    <color=#C792EA>string</color>
    orientador = <color=#F5C542>\"Nicolas Antonio Messias dos Santos Colloca\"</color>;\n\n<color=#5D6B8A>   
    // Faculdade de Engenharia e Administra\xE7\xE3o Paulista</color>\n    <color=#C792EA>string</color>
    instituicao = <color=#F5C542>\"FEAP Avar\xE9\"</color>;\n    <color=#C792EA>string</color>
    curso       = <color=#F5C542>\"Engenharia de Computa\xE7\xE3o\"</color>;\n\n<color=#5D6B8A>   
    // O que voc\xEA aprende jogando</color>\n    <color=#C792EA>string</color>[]
    fisica    = { <color=#F5C542>\"Rigidbody2D\"</color>, <color=#F5C542>\"Collider2D\"</color>,
    <color=#F5C542>\"Pulo\"</color> };\n    <color=#C792EA>string</color>[] interacao
    = { <color=#F5C542>\"OnTriggerEnter2D\"</color>, <color=#F5C542>\"Is Trigger\"</color>,
    <color=#F5C542>\"Vida\"</color> };\n    <color=#C792EA>string</color>[] animacao 
    = { <color=#F5C542>\"Animation Clip\"</color>, <color=#F5C542>\"FPS\"</color>,
    <color=#F5C542>\"Animator\"</color> };\n    <color=#C792EA>string</color>[] ia       
    = { <color=#F5C542>\"M\xE1quina de estados\"</color>, <color=#F5C542>\"Raycast\"</color>
    };\n\n<color=#5D6B8A>    // Feito com</color>\n    <color=#C792EA>string</color>
    motor  = <color=#F5C542>\"Unity 6 \xB7 URP 2D\"</color>;\n    <color=#C792EA>string</color>
    fontes = <color=#F5C542>\"Baloo 2 \xB7 Nunito \xB7 JetBrains Mono\"</color>;\n\n   
    <color=#C792EA>void</color> <color=#82AAFF>Start</color>() => <color=#5FD4E8>Debug</color>.<color=#82AAFF>Log</color>(<color=#F5C542>\"Obrigado
    por jogar!\"</color>);\n}"
