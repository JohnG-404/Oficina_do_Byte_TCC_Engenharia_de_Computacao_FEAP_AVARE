  m_Script: {fileID: 11500000, guid: 0b9791c953f73be4aa52a81aba790db7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteracaoLevelFlow
  nextSceneName: Interacao_Vida
  delayBeforeNextScene: 1.5
  dialogueManager: {fileID: 623616406}
  introDialogue:
  - "Esta sala est\xE1 cheia de objetos, mas nenhum faz nada. Ainda."
  - "Muita coisa num jogo funciona assim: algo detecta voc\xEA (um collider) e responde
    com uma consequ\xEAncia. Aqui, quem decide isso \xE9 voc\xEA."
  - "Clique num objeto e configure duas coisas: a A\xC7\xC3O, como voc\xEA interage
    (apertar um bot\xE3o, chegar perto, ter pegado um cart\xE3o...), e a CONSEQU\xCANCIA,
    o que acontece (abrir uma porta, ativar uma plataforma...)."
  - "Explore a sala, teste combina\xE7\xF5es e descubra qual delas abre o caminho
    at\xE9 a sa\xEDda."
  firstConfigHint: "Boa! Agora vai l\xE1 testar."
  firstDoorHint: "Show! Essa combina\xE7\xE3o funcionou."
  firstRestartHint: "N\xE3o foi dessa vez. Vamos tentar de novo!"
  firstDamageHint: Ai! Cada armadilha tira vida. Fica de olho nos quadrados.
  firstHealHint: Vida recuperada!
  restartHintDelay: 0.8
  completeUI: {fileID: 1052003711}
  playerHealth: {fileID: 0}
  gameOverUI: {fileID: 0}
