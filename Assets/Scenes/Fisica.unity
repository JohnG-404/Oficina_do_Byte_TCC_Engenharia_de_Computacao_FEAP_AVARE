  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetivoFase
  etapas:
  - titulo: "Monte o c\xF3digo do Movimento"
    dica: "Arraste cada pe\xE7a pro espa\xE7o certo."
  - titulo: Ande com o personagem
    dica: Setas ou {andar}.
  - titulo: "Monte o script da C\xE2mera"
    dica: "A c\xE2mera precisa ir atr\xE1s do personagem."
  - titulo: Ande mais um pouco
    dica: "Agora a c\xE2mera vai junto."
  - titulo: Monte o Rigidbody2D
    dica: 'Ele flutua sem peso: falta gravidade.'
  - titulo: Monte o Collider2D
    dica: "Ele atravessou o ch\xE3o: falta um corpo s\xF3lido."
  - titulo: "Teste andar com f\xEDsica e colis\xE3o"
    dica: "D\xEA uma volta pela sala."
  - titulo: "Monte o c\xF3digo do Pulo"
    dica: Personagem de plataforma precisa pular.
  - titulo: Pule com {pular}
    dica: "S\xF3 d\xE1 pra pular apoiado no ch\xE3o."
