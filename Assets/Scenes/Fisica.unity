  tituloCodigo: "C\xF3digo montado \xB7 CameraFollow"
  codigoMontado: "public Transform <color=#F5C542>target</color>;             //
    arraste o Player aqui\npublic float minX = 0f, maxX = 20f;  // bordas da sala\nVector3
    vel;                         // o SmoothDamp guarda a velocidade aqui\nvoid <color=#F5C542>LateUpdate</color>()\n{\n     
    Vector3 pos = Vector3.<color=#F5C542>SmoothDamp</color>(transform.position, target.position,
    ref vel, 0.25f);\n      pos.x = Mathf.Clamp(pos.x, <color=#F5C542>minX, maxX</color>);\n     
    transform.position = new Vector3(pos.x, pos.y, -10);\n}"
  segundosCodigo: 3
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
  totalPieces: 4
  puzzle: {fileID: 304120141}
