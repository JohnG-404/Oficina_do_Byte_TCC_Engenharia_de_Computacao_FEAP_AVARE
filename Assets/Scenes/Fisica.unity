  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PuzzleControl
  flowManager: {fileID: 957842907}
  listener: {fileID: 0}
  tituloCodigo: "C\xF3digo montado \xB7 Pulo"
  codigoMontado: "public float pulo = 7f;\npublic bool isGrounded;   // fica true
    enquanto pisa no ch\xE3o (Colis\xE3o)\nRigidbody2D rb;\nvoid Start() { rb = GetComponent<Rigidbody2D>();
    }\nvoid Update()\n{\n      if (<color=#F5C542>Input</color>.GetButtonDown(\"<color=#F5C542>Jump</color>\")
    && <color=#F5C542>isGrounded</color>)\n            rb.<color=#F5C542>linearVelocity</color>
    = new Vector2(rb.linearVelocity.x, pulo);\n}"
  segundosCodigo: 3
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
  totalPieces: 4
  puzzle: {fileID: 843220510}
