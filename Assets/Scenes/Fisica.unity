  tituloCodigo: "C\xF3digo montado \xB7 Movimento"
  codigoMontado: "public float velocidade = 5f;\nvoid Update()\n{\n      float h
    = <color=#F5C542>Input</color>.GetAxis(\"<color=#F5C542>Horizontal</color>\");\n     
    <color=#F5C542>Vector2</color> direcao = new Vector2(h, 0);\n      <color=#F5C542>transform.position</color>
    += (Vector3)direcao * velocidade * Time.deltaTime;\n}"
  segundosCodigo: 3
  segundosPecaErrada: 0.6
  pixelsTremida: 6
  segundosAvisoErro: 3
