--- !u!114 &665834437
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 665834436}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9e5324d6a617c40ada1c80015a5088, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimatorPuzzleUI
  pecas:
  - texto: agachado == true
    textoAnimator: agachado == true
    descricao: "Bool novo do Animator. O script deixa ele verdadeiro enquanto a tecla
      de agachar est\xE1 apertada e o corpo est\xE1 baixo."
    setaCorreta: 4
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.9843137, g: 0.57254905, b: 0.23529412, a: 1}
    subtitulo: Bool do Animator
  - texto: Input.GetKeyDown(C)
    textoAnimator: 
    descricao: "Verdadeiro s\xF3 no quadro em que a tecla C foi apertada. No quadro
      seguinte j\xE1 \xE9 falso."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 1ef48801aead5fc4d9381a7f2469a34b, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: ENTRADA
    corCategoria: {r: 0.95686275, g: 0.44705883, b: 0.7137255, a: 1}
    subtitulo: teclado
  - texto: velocidadeX > 0.1
    textoAnimator: velocidadeX > 0.1
    descricao: "A velocidade horizontal, o mesmo par\xE2metro da Corrida. Maior que
      0.1 quer dizer que o personagem est\xE1 andando."
    setaCorreta: 5
    icone: {fileID: 21300000, guid: c538972bb0df5ac498d23c4a0fc3d2b3, type: 3}
    moldura: {fileID: 21300000, guid: a1a8c8391fdfd5143b76a836d38fe74d, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.5058824, g: 0.54901963, b: 0.972549, a: 1}
    subtitulo: Float do Animator
  - texto: noChao == false
    textoAnimator: 
    descricao: "Verdadeiro quando o personagem est\xE1 no ar. \xC9 a condi\xE7\xE3o
      usada na seta do Pulo."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.9843137, g: 0.57254905, b: 0.23529412, a: 1}
    subtitulo: Bool do Animator
  - texto: transform.localScale.y < 1
    textoAnimator: 
    descricao: Compara a escala vertical do objeto com 1.
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 2267ab47f2d09614aa0839dc3c0599ec, type: 3}
    moldura: {fileID: 21300000, guid: 4297619242d4d5148bb2ab9a75bdee77, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.23921569, g: 0.64705884, b: 1, a: 1}
    subtitulo: Transform
  fase: "Fase Anima\xE7\xE3o"
  numeroPuzzle: 2
  etapas:
  - Animator do Player
  - Agachar
  abaJanela: Player
  legendaDiagrama: "ANIMATOR DO PLAYER \xB7 BASE LAYER"
  objetivo: o desenho abaixa junto com o corpo
  dicasSetas:
  - "Seta 1, de Idle para Agachado: quem avisa o Animator que o jogador agachou?
    O script liga um par\xE2metro novo enquanto a tecla est\xE1 apertada."
  - "Seta 2, de Agachado para AndarAgachado: qual par\xE2metro j\xE1 dizia se o personagem
    est\xE1 andando, l\xE1 na seta da Corrida?"
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  iconesProntas:
  - {fileID: 21300000, guid: c538972bb0df5ac498d23c4a0fc3d2b3, type: 3}
  - {fileID: 21300000, guid: c538972bb0df5ac498d23c4a0fc3d2b3, type: 3}
  - {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
  - {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: 'As setas novas foram zeradas. Pense: o que o script avisa quando o
    jogador agacha? E o que muda quando ele anda?'
  concluidoTitulo: Agachar montado!
  concluidoTexto: "As duas setas novas t\xEAm condi\xE7\xE3o. Olhe a pr\xE9via: agora
    o desenho abaixa junto com o corpo."
  spriteIdle: {fileID: 21300000, guid: 4aef0d978e6decd488d546608314ffa6, type: 3}
  pesNoSprite: 0.04
  framesCorrida:
  - {fileID: 21300000, guid: 3c92ceab5f950134f847ed24a0252919, type: 3}
  - {fileID: 21300000, guid: d8fe8f6398742d94fb0c4a99601f7863, type: 3}
  - {fileID: 21300000, guid: c07d866700f0934429211eb74b1a3daf, type: 3}
  - {fileID: 21300000, guid: f9576a888c5d6d645a7d2d28478224c3, type: 3}
  - {fileID: 21300000, guid: b32ea029f06ddaa45a981a41b60d9e59, type: 3}
  - {fileID: 21300000, guid: 8a138ddd70fdc2c42b6cd7ec65996479, type: 3}
  framesPulo:
  - {fileID: 21300000, guid: 53622dc15babccf469fbeec99602caa4, type: 3}
  - {fileID: 21300000, guid: 5b51656d12c1b984798ca0a487b79e57, type: 3}
  - {fileID: 21300000, guid: 5522736a0082fd249bd832b214bb3df8, type: 3}
  - {fileID: 21300000, guid: 447e6b94baffa3f4b92405bedf992a90, type: 3}
  framesPorSegundo: 12
  modoAgachar: 1
  condicoesProntas:
  - velocidadeX > 0.1
  - velocidadeX < 0.1
  - noChao == false
  - noChao == true
  framesAgachado:
  - {fileID: 21300000, guid: 999b1194c72eaad46945babd6a817ac7, type: 3}
  - {fileID: 21300000, guid: c8f5514a0bc31934e9b4f8a05e1722e9, type: 3}
  - {fileID: 21300000, guid: 11dae0b8bae308446912ff537f3eb9b3, type: 3}
