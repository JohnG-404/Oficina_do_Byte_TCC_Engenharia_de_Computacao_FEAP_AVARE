--- !u!114 &1914451765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1914451763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f79c9591ffeed9e4baf8337124925635, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoAnimatorUI
  tipo: jumppad
  configurado: 0
  parametro: pular
  tipoParametro: Trigger
  quemMuda: (o script dispara ao pisar)
  estados:
  - nome: Repouso
    quadros:
    - {fileID: 21300000, guid: b9dfd2d2b5050b94cb63ce1d2f64f7fa, type: 3}
    fps: 6
    loop: 0
    someNoFim: 0
  - nome: Impulso
    quadros:
    - {fileID: 21300000, guid: b9dfd2d2b5050b94cb63ce1d2f64f7fa, type: 3}
    - {fileID: 21300000, guid: cbb62dc5cb4acf34d9c758504d68232a, type: 3}
    - {fileID: 21300000, guid: fc730b18a07151941a725405ca3060f9, type: 3}
    - {fileID: 21300000, guid: 1afa50ddf135e7348b06bede314edf7e, type: 3}
    - {fileID: 21300000, guid: df184c5be87c82f4dbb7c8d68d3c3d2a, type: 3}
    - {fileID: 21300000, guid: 022962d7a5a09264993dad592883eb6a, type: 3}
    - {fileID: 21300000, guid: 82b6a1b99fc096c468ca229fc66ebd1b, type: 3}
    - {fileID: 21300000, guid: 809f2a7f92119364eb7b3b0e439c7469, type: 3}
    fps: 14.222222
    loop: 0
    someNoFim: 0
  estadoInicial: 0
  setas:
  - de: 0
    para: 1
    condicao: 0
    valor: 0
  - de: 1
    para: 0
    condicao: 1
    valor: 0
  pecas:
  - texto: pular (Trigger)
    textoAnimator: 
    descricao: "O Trigger pular \xE9 disparado pelo script quando o personagem cai
      em cima do jumppad. A seta segue uma vez e o Trigger volta sozinho."
    setaCorreta: 0
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Trigger do Animator
  - texto: isGrounded == false
    textoAnimator: 
    descricao: "Par\xE2metro do Animator do Player: verdadeiro quando ele est\xE1
      no ar."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 166f0b7c7fe1ace41a57cd45818ca81d, type: 3}
    moldura: {fileID: 21300000, guid: b71c0a6f4b602fa4290a00b79ab3ccf2, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.204, g: 0.788, b: 0.549, a: 1}
    subtitulo: "Collider2D \xB7 ch\xE3o"
  - texto: Has Exit Time
    textoAnimator: 
    descricao: "Sem condi\xE7\xE3o: a seta segue quando o clipe chega ao fim."
    setaCorreta: 1
    icone: {fileID: 21300000, guid: e3fdeaf47b7948c449e808da35269e5d, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "TRANSI\xC7\xC3O"
    corCategoria: {r: 0.639, g: 0.902, b: 0.208, a: 1}
    subtitulo: espera o clipe acabar
  - texto: pular == false
    textoAnimator: 
    descricao: "Um Trigger n\xE3o tem valor true ou false pra testar: ele s\xF3 dispara
      e volta sozinho."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Trigger do Animator
  - texto: Input.GetKey(Space)
    textoAnimator: 
    descricao: "L\xEA o teclado dentro de um script: verdadeiro enquanto a barra
      de espa\xE7o est\xE1 apertada."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 1ef48801aead5fc4d9381a7f2469a34b, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: ENTRADA
    corCategoria: {r: 0.957, g: 0.447, b: 0.714, a: 1}
    subtitulo: teclado
  - texto: ligada == true
    textoAnimator: 
    descricao: "Par\xE2metro Bool do Animator da l\xE2mpada."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Bool do Animator
  titulo: Configure o Animator do Jumppad
  fase: "Fase Anima\xE7\xE3o"
  objetivo: 
  tituloDiagrama: Animator do Jumppad (Base Layer)
  textoEncaixeVazio: "arraste uma condi\xE7\xE3o"
  descricaoTitulo: "Um jumppad que d\xE1 impulso"
  descricaoPadrao: "Quando o personagem cai em cima, o script dispara o Trigger pular.
    Uma seta leva para Impulso; a outra precisa trazer o jumppad de volta para Repouso.
    Sem as setas, o jumppad n\xE3o funciona."
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: 'O Animator do jumppad foi zerado. Pense: o que faz ele ir para Impulso?
    E como ele sabe a hora de voltar?'
  concluidoTitulo: Jumppad configurado!
  concluidoTexto: "Na pr\xE9via, pular leva para Impulso, e o Has Exit Time volta
    para Repouso quando o clipe acaba."
  tituloPrevia: "Pr\xE9via"
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  cicloSegundos: 2.6
  reiniciarNoCiclo: 0
  eventos:
  - tempo: 0.9
    valor: 0
    leitura: 'o personagem cai em cima: pular disparado'
  leituraParado: "esperando algu\xE9m pisar"
  inverterX: 0
  inverterY: 0
  tamanhoPrevia: {x: 150, y: 150}
  falasSemAnimator:
  - "Esse jumppad n\xE3o reage: o Animator dele ainda n\xE3o foi configurado."
  - Clique nele ou use a tecla de interagir perto dele pra abrir o Animator.
  tituloCodigo: Animator do jumppad
  codigo: "<color=#8B95A7>// JumppadFase: o personagem caiu em cima</color>\nanimator.SetTrigger(<color=#F5C542>\"pular\"</color>);\nplayer.Impulsionar(altura);\n<color=#8B95A7>//
    Transi\xE7\xF5es (as setas que voc\xEA montou)</color>\nRepouso -> Impulso: 
    <color=#F5C542>pular</color> (Trigger)\nImpulso -> Repouso:  <color=#F5C542>Has
    Exit Time</color> (sem condi\xE7\xE3o)"
  segundosCodigo: 12
  sortingOrder: 400
