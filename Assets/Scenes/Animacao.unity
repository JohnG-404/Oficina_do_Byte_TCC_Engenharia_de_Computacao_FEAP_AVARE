  etapas:
  - titulo: "Ande e pule pelo laborat\xF3rio"
    dica: Repare no desenho do personagem.
  - titulo: "Monte as transi\xE7\xF5es do Animator"
    dica: "Encaixe as condi\xE7\xF5es nas setas."
  - titulo: Suba a escada e pule a vala de espinhos
    dica: Agora ele anima sozinho.
  - titulo: "Segure agachar perto do t\xFAnel"
    dica: Veja o corpo e o desenho.
  - titulo: Monte as setas do agachar no Animator
    dica: O desenho precisa abaixar junto.
  - titulo: "Atravesse o t\xFAnel at\xE9 a porta"
    dica: Segure agachar pra passar.
  segundosGrande: 3.5
  segundosFade: 0.25
