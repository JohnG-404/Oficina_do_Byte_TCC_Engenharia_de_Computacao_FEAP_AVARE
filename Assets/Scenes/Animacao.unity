  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e2531c36f3504348adb7adfe677cf83, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BateriaFase
  animator: {fileID: 1031328637}
  cargaMaxima: 2
  porta: {fileID: 1977197205}
  distanciaAviso: 3
  falasPrimeiraCarga:
  - "A bateria ao lado da porta tem um par\xE2metro Int chamado carga. Cada alavanca
    soma 1."
  - 'No Animator, cada seta testa um valor: carga == 1 mostra meia carga, carga ==
    2 mostra a bateria cheia.'
  falasCheia:
  - "Bateria cheia: carga == 2, e a porta de sa\xEDda foi destrancada."
  - "A porta vai de Fechada para Abrindo e passa para Aberta quando o clipe termina,
    sem condi\xE7\xE3o nenhuma. Isso \xE9 Has Exit Time."
  falasTrancada:
  - "A porta est\xE1 trancada. Ela s\xF3 abre com a bateria cheia: puxe as duas alavancas
    da fase."
  - "Uma fica em cima da laje (use o jumppad) e a outra no fundo do po\xE7o."
