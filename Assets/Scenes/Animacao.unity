  configurado: 0
  parametro: carga
  tipoParametro: Int
  quemMuda: (cada alavanca soma 1)
  estados:
  - nome: Vazia
    quadros:
    - {fileID: 21300000, guid: 72612c28d270ac64a910330f2f05edae, type: 3}
    fps: 6
    loop: 0
    someNoFim: 0
  - nome: Metade
    quadros:
    - {fileID: 21300000, guid: 60b007b249e581041afc245210adbb13, type: 3}
    - {fileID: 21300000, guid: 32468f7e00895eb44a19aaa47d257a21, type: 3}
    fps: 5.3333335
    loop: 0
    someNoFim: 0
  - nome: Cheia
    quadros:
    - {fileID: 21300000, guid: d5c82e836e94024468b5fd865f4e4416, type: 3}
    - {fileID: 21300000, guid: 4eb2ca2bf557026479c0e30e680eafa0, type: 3}
    fps: 5.3333335
    loop: 0
    someNoFim: 0
  estadoInicial: 0
  setas:
  - de: -1
    para: 0
    condicao: 2
    valor: 0
  - de: -1
    para: 1
    condicao: 2
    valor: 1
  - de: -1
    para: 2
    condicao: 2
    valor: 2
  pecas:
  - texto: carga == 2
    textoAnimator: 
    descricao: "O par\xE2metro Int carga vale 2: as duas alavancas foram puxadas."
    setaCorreta: 2
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Int do Animator
  - texto: carga > 0
    textoAnimator: 
    descricao: 'Verdadeiro com qualquer carga acima de zero: 1 ou 2.'
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Int do Animator
  - texto: carga == 0
    textoAnimator: 
    descricao: "O par\xE2metro Int carga vale 0: nenhuma alavanca foi puxada ainda."
    setaCorreta: 0
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Int do Animator
  - texto: puxar (Trigger)
    textoAnimator: 
    descricao: Trigger do Animator da alavanca.
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Trigger do Animator
  - texto: carga == 1
    textoAnimator: 
    descricao: "O par\xE2metro Int carga vale 1: uma alavanca foi puxada."
    setaCorreta: 1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Int do Animator
  - texto: Has Exit Time
    textoAnimator: 
    descricao: "Sem condi\xE7\xE3o: a seta segue quando o clipe chega ao fim."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: e3fdeaf47b7948c449e808da35269e5d, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "TRANSI\xC7\xC3O"
    corCategoria: {r: 0.639, g: 0.902, b: 0.208, a: 1}
    subtitulo: espera o clipe acabar
  titulo: Configure o Animator da Bateria
  fase: "Fase Anima\xE7\xE3o"
  objetivo: 
  tituloDiagrama: Animator da Bateria (Base Layer)
  textoEncaixeVazio: "arraste uma condi\xE7\xE3o"
  descricaoTitulo: "Uma bateria com par\xE2metro Int"
  descricaoPadrao: "A bateria tem um par\xE2metro Int chamado carga: cada alavanca
    puxada soma 1. Do Any State sai uma seta pra cada estado, e cada seta testa um
    valor. Sem as setas, a bateria n\xE3o mostra a carga e a porta n\xE3o destranca."
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: 'O Animator da bateria foi zerado. Pense: qual valor de carga combina
    com cada desenho da bateria?'
  concluidoTitulo: Bateria configurada!
  concluidoTexto: "Na pr\xE9via, carga vai de 0 a 2 e o Any State leva direto para
    o estado com o valor certo."
  tituloPrevia: "Pr\xE9via"
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  cicloSegundos: 5.4
  reiniciarNoCiclo: 0
  eventos:
  - tempo: 0.05
    valor: 0
    leitura: 'nenhuma alavanca puxada: carga = 0'
  - tempo: 1.8
    valor: 1
    leitura: 'uma alavanca puxada: carga = 1'
  - tempo: 3.6
    valor: 2
    leitura: 'duas alavancas puxadas: carga = 2'
  leituraParado: 
  inverterX: 0
  inverterY: 0
  tamanhoPrevia: {x: 150, y: 150}
  falasSemAnimator:
  - "Essa bateria n\xE3o mostra a carga: o Animator dela ainda n\xE3o foi configurado.
    Sem ele, a porta n\xE3o destranca."
  - Clique nela ou use a tecla de interagir perto dela pra abrir o Animator.
  tituloCodigo: Animator da bateria
  codigo: "<color=#8B95A7>// BateriaFase: cada alavanca puxada soma 1</color>\ncarga++;\nanimator.SetInteger(<color=#F5C542>\"carga\"</color>,
    carga);\n<color=#8B95A7>// Transi\xE7\xF5es (as setas que voc\xEA montou)</color>\nAny
    State -> Vazia:   <color=#F5C542>carga == 0</color>\nAny State -> Metade:  <color=#F5C542>carga
    == 1</color>\nAny State -> Cheia:   <color=#F5C542>carga == 2</color>"
  segundosCodigo: 12
  sortingOrder: 400
