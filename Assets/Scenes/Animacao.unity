    textoAnimator: noChao == true
    descricao: "Verdadeiro quando o personagem est\xE1 com os p\xE9s em alguma superf\xEDcie:
      o ch\xE3o ou o topo de um degrau."
    setaCorreta: 3
    icone: {fileID: 21300000, guid: 166f0b7c7fe1ace41a57cd45818ca81d, type: 3}
    moldura: {fileID: 21300000, guid: b71c0a6f4b602fa4290a00b79ab3ccf2, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.20392157, g: 0.7882353, b: 0.54901963, a: 1}
    subtitulo: 'Animator: noChao == true'
  - texto: Input.GetKey(Space)
    textoAnimator: 
    descricao: "Verdadeiro enquanto a tecla de pular est\xE1 apertada."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 1ef48801aead5fc4d9381a7f2469a34b, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: ENTRADA
    corCategoria: {r: 0.95686275, g: 0.44705883, b: 0.7137255, a: 1}
    subtitulo: teclado
  - texto: linearVelocity.x != 0
    textoAnimator: velocidadeX > 0.1
    descricao: "A velocidade horizontal do Rigidbody2D \xE9 diferente de zero: o
      personagem est\xE1 se movendo pra esquerda ou pra direita."
    setaCorreta: 0
    icone: {fileID: 21300000, guid: 5a9053db9d5db2042ad613308a646c95, type: 3}
    moldura: {fileID: 21300000, guid: 4297619242d4d5148bb2ab9a75bdee77, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.23921569, g: 0.64705884, b: 1, a: 1}
    subtitulo: 'Animator: velocidadeX > 0.1'
  - texto: Start()
    textoAnimator: 
    descricao: "M\xE9todo que o Unity chama uma \xFAnica vez, quando o objeto come\xE7a."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 7526b77a00a003f4190305f1dfe044fd, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "M\xC9TODO"
    corCategoria: {r: 0.6392157, g: 0.9019608, b: 0.20784314, a: 1}
    subtitulo: MonoBehaviour
  - texto: isGrounded == false
    textoAnimator: noChao == false
    descricao: "Verdadeiro quando o personagem n\xE3o est\xE1 encostado em nenhum
      ch\xE3o: subiu num pulo ou est\xE1 caindo de uma beirada."
    setaCorreta: 2
    icone: {fileID: 21300000, guid: 166f0b7c7fe1ace41a57cd45818ca81d, type: 3}
    moldura: {fileID: 21300000, guid: b71c0a6f4b602fa4290a00b79ab3ccf2, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.20392157, g: 0.7882353, b: 0.54901963, a: 1}
    subtitulo: 'Animator: noChao == false'
  - texto: transform.position.y > 0
    textoAnimator: 
    descricao: Compara a altura do personagem com o zero do mundo.
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 2267ab47f2d09614aa0839dc3c0599ec, type: 3}
    moldura: {fileID: 21300000, guid: 4297619242d4d5148bb2ab9a75bdee77, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.23921569, g: 0.64705884, b: 1, a: 1}
    subtitulo: Transform
  - texto: linearVelocity.x == 0
    textoAnimator: velocidadeX < 0.1
    descricao: "A velocidade horizontal do Rigidbody2D \xE9 zero: o personagem n\xE3o
      est\xE1 indo nem pra esquerda nem pra direita."
    setaCorreta: 1
    icone: {fileID: 21300000, guid: 5a9053db9d5db2042ad613308a646c95, type: 3}
    moldura: {fileID: 21300000, guid: 4297619242d4d5148bb2ab9a75bdee77, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.23921569, g: 0.64705884, b: 1, a: 1}
    subtitulo: 'Animator: velocidadeX < 0.1'
  fase: "Fase Anima\xE7\xE3o"
  numeroPuzzle: 1
  etapas:
  - Animator do Player
  - Agachar
  abaJanela: Player
  legendaDiagrama: "ANIMATOR DO PLAYER \xB7 BASE LAYER"
  objetivo: "a anima\xE7\xE3o acompanha a f\xEDsica"
  dicasSetas:
  - "Seta 1, de Idle para Corrida: o que muda no Rigidbody2D quando o personagem
    come\xE7a a andar?"
  - 'Seta 2, de Corrida para Idle: o que fica igual a zero quando o personagem para?'
  - "Seta 3, de Any State para Pulo: o que deixa de ser verdade quando os p\xE9s
    saem do ch\xE3o?"
  - 'Seta 4, de Pulo para Idle: o que avisa que o personagem voltou a pisar em alguma
    coisa?'
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  iconesProntas: []
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: "O Animator foi zerado. Leia as pe\xE7as de novo e pense: o que precisa
    ser verdade pra trocar de uma anima\xE7\xE3o pra outra?"
  concluidoTitulo: Animator montado!
  concluidoTexto: "As quatro setas t\xEAm condi\xE7\xE3o. Olhe a pr\xE9via: agora
    a anima\xE7\xE3o acompanha a f\xEDsica sozinha."
  spriteIdle: {fileID: 21300000, guid: 4aef0d978e6decd488d546608314ffa6, type: 3}
  pesNoSprite: 0.04
  framesCorrida:
  - {fileID: 21300000, guid: 3c92ceab5f950134f847ed24a0252919, type: 3}
  - {fileID: 21300000, guid: d8fe8f6398742d94fb0c4a99601f7863, type: 3}
  - {fileID: 21300000, guid: c07d866700f0934429211eb74b1a3daf, type: 3}
  - {fileID: 21300000, guid: f9576a888c5d6d645a7d2d28478224c3, type: 3}
  - {fileID: 21300000, guid: b32ea029f06ddaa45a981a41b60d9e59, type: 3}
  - {fileID: 21300000, guid: 8a138ddd70fdc2c42b6cd7ec65996479, type: 3}
  framesPulo:
  - {fileID: 21300000, guid: 53622dc15babccf469fbeec99602caa4, type: 3}
  - {fileID: 21300000, guid: 5b51656d12c1b984798ca0a487b79e57, type: 3}
  - {fileID: 21300000, guid: 5522736a0082fd249bd832b214bb3df8, type: 3}
  - {fileID: 21300000, guid: 447e6b94baffa3f4b92405bedf992a90, type: 3}
  framesPorSegundo: 12
  modoAgachar: 0
  condicoesProntas:
  - velocidadeX > 0.1
  - velocidadeX < 0.1
  - noChao == false
  - noChao == true
  framesAgachado:
  - {fileID: 21300000, guid: 999b1194c72eaad46945babd6a817ac7, type: 3}
  - {fileID: 21300000, guid: c8f5514a0bc31934e9b4f8a05e1722e9, type: 3}
  - {fileID: 21300000, guid: 11dae0b8bae308446912ff537f3eb9b3, type: 3}
  - {fileID: 21300000, guid: 86b44f755a4d99442bd0aa9c49c960a5, type: 3}
  framesAndarAgachado:
  - {fileID: 21300000, guid: ac472a85fc4af9f4a801c8157fcf8e87, type: 3}
  - {fileID: 21300000, guid: 58db4d9c206c03e4d90df1ef68581ab7, type: 3}
  - {fileID: 21300000, guid: b5f8c7edc12cad54d82e9d27f259e6df, type: 3}
  - {fileID: 21300000, guid: 70d6b14b9c1ab7947826d84652be9708, type: 3}
  sortingOrder: 400
