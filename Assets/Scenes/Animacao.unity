--- !u!114 &1025857417
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1025857415}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f79c9591ffeed9e4baf8337124925635, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoAnimatorUI
  tipo: alavanca
  configurado: 0
  parametro: puxar
  tipoParametro: Trigger
  quemMuda: (o script dispara na tecla de interagir)
  estados:
  - nome: Parada
    quadros:
    - {fileID: 21300000, guid: af12ce87fc18ec0499b886d67dbb036e, type: 3}
    fps: 6
    loop: 0
    someNoFim: 0
  - nome: Puxando
    quadros:
    - {fileID: 21300000, guid: af12ce87fc18ec0499b886d67dbb036e, type: 3}
    - {fileID: 21300000, guid: c6ee05554476e1845bd270ae89d39d97, type: 3}
    - {fileID: 21300000, guid: 5610175d09cb48b4895587e2484b9814, type: 3}
    - {fileID: 21300000, guid: d5f2a19da8affa447aad490dd3d6134d, type: 3}
    - {fileID: 21300000, guid: d387c0906fb724d49b5b0c569abaef47, type: 3}
    - {fileID: 21300000, guid: 01309feeae3d33d468a2d51111803096, type: 3}
    - {fileID: 21300000, guid: 5a60a56c892a66b478eab24fcd719aec, type: 3}
    - {fileID: 21300000, guid: fe5bc7903cf13d349badbe507783fca3, type: 3}
    - {fileID: 21300000, guid: ecde224655c1b914db5d6e7c1dc53003, type: 3}
    fps: 10.8
    loop: 0
    someNoFim: 0
  - nome: Puxada
    quadros:
    - {fileID: 21300000, guid: ecde224655c1b914db5d6e7c1dc53003, type: 3}
    fps: 6
    loop: 0
    someNoFim: 0
  estadoInicial: 0
  setas:
  - de: 0
    para: 1
    condicao: 0
    valor: 0
  - de: 1
    para: 2
    condicao: 1
    valor: 0
  pecas:
  - texto: Input.GetKeyDown(E)
    textoAnimator: 
    descricao: "L\xEA o teclado dentro de um script: verdadeiro no quadro em que
      a tecla E \xE9 apertada."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 1ef48801aead5fc4d9381a7f2469a34b, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: ENTRADA
    corCategoria: {r: 0.957, g: 0.447, b: 0.714, a: 1}
    subtitulo: teclado
  - texto: puxar (Trigger)
    textoAnimator: 
    descricao: "O Trigger puxar \xE9 disparado pelo script quando o jogador aperta
      a tecla de interagir perto da alavanca."
    setaCorreta: 0
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Trigger do Animator
  - texto: carga == 1
    textoAnimator: 
    descricao: "Par\xE2metro Int do Animator da bateria."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Int do Animator
  - texto: Has Exit Time
    textoAnimator: 
    descricao: "Sem condi\xE7\xE3o: a seta segue quando o clipe chega ao fim."
    setaCorreta: 1
    icone: {fileID: 21300000, guid: e3fdeaf47b7948c449e808da35269e5d, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "TRANSI\xC7\xC3O"
    corCategoria: {r: 0.639, g: 0.902, b: 0.208, a: 1}
    subtitulo: espera o clipe acabar
  - texto: velocidadeX > 0.1
    textoAnimator: 
    descricao: "Par\xE2metro do Animator do Player: a velocidade horizontal dele."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: c538972bb0df5ac498d23c4a0fc3d2b3, type: 3}
    moldura: {fileID: 21300000, guid: a1a8c8391fdfd5143b76a836d38fe74d, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.506, g: 0.549, b: 0.973, a: 1}
    subtitulo: Float do Player
  - texto: puxar == false
    textoAnimator: 
    descricao: "Um Trigger n\xE3o tem valor true ou false pra testar: ele s\xF3 dispara
      e volta sozinho."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Trigger do Animator
  titulo: Configure o Animator da Alavanca
  fase: "Fase Anima\xE7\xE3o"
  objetivo: 
  tituloDiagrama: Animator da Alavanca (Base Layer)
  textoEncaixeVazio: "arraste uma condi\xE7\xE3o"
  descricaoTitulo: "Uma alavanca de tr\xEAs estados"
  descricaoPadrao: "A tecla de interagir faz o script disparar o Trigger puxar. A
    alavanca vai de Parada para Puxando e, quando o clipe acaba, fica em Puxada.
    Sem as setas, ela n\xE3o sai do lugar."
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: 'O Animator da alavanca foi zerado. Pense: o que tira a alavanca de
    Parada? E o que leva de Puxando para Puxada?'
  concluidoTitulo: Alavanca configurada!
  concluidoTexto: "Na pr\xE9via, puxar leva para Puxando, e o Has Exit Time termina
    em Puxada."
  tituloPrevia: "Pr\xE9via"
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  cicloSegundos: 3.6
  reiniciarNoCiclo: 1
  eventos:
  - tempo: 1
    valor: 0
    leitura: 'tecla de interagir: puxar disparado'
  leituraParado: "esperando algu\xE9m puxar"
  inverterX: 0
  inverterY: 0
  tamanhoPrevia: {x: 150, y: 150}
  falasSemAnimator:
  - "Essa alavanca est\xE1 travada: o Animator dela ainda n\xE3o foi configurado."
  - Clique nela ou use a tecla de interagir perto dela pra abrir o Animator.
  tituloCodigo: Animator da alavanca
  codigo: "<color=#8B95A7>// AlavancaFase: tecla de interagir perto dela</color>\nanimator.SetTrigger(<color=#F5C542>\"puxar\"</color>);\nbateria.Carregar();\n<color=#8B95A7>//
    Transi\xE7\xF5es (as setas que voc\xEA montou)</color>\nParada -> Puxando:  <color=#F5C542>puxar</color>
    (Trigger)\nPuxando -> Puxada:  <color=#F5C542>Has Exit Time</color> (sem condi\xE7\xE3o)"
  segundosCodigo: 12
  sortingOrder: 400
