--- !u!114 &596641613
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 596641609}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6bdaab11ae3a1e84787822e6d6116664, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LampadaAnimatorUI
  pecas:
  - texto: isGrounded == true
    textoAnimator: 
    descricao: "Par\xE2metro do Animator do Player: verdadeiro quando ele est\xE1
      com os p\xE9s no ch\xE3o."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 166f0b7c7fe1ace41a57cd45818ca81d, type: 3}
    moldura: {fileID: 21300000, guid: b71c0a6f4b602fa4290a00b79ab3ccf2, type: 3}
    categoria: "CONDI\xC7\xC3O"
    corCategoria: {r: 0.204, g: 0.788, b: 0.549, a: 1}
    subtitulo: "Collider2D \xB7 ch\xE3o"
  - texto: ligada == true
    textoAnimator: 
    descricao: "O par\xE2metro Bool ligada vale true. O sensor da sala deixa ligada
      = true enquanto tem algu\xE9m l\xE1 dentro."
    setaCorreta: 0
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Bool do Animator
  - texto: Input.GetMouseButton(0)
    textoAnimator: 
    descricao: "Verdadeiro enquanto o bot\xE3o esquerdo do mouse est\xE1 apertado."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 1ef48801aead5fc4d9381a7f2469a34b, type: 3}
    moldura: {fileID: 21300000, guid: cd9fc7fcc11b710479c9b92305f3789c, type: 3}
    categoria: ENTRADA
    corCategoria: {r: 0.957, g: 0.447, b: 0.714, a: 1}
    subtitulo: mouse
  - texto: velocidadeX > 0.1
    textoAnimator: 
    descricao: "Par\xE2metro do Animator do Player: a velocidade horizontal dele."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: c538972bb0df5ac498d23c4a0fc3d2b3, type: 3}
    moldura: {fileID: 21300000, guid: a1a8c8391fdfd5143b76a836d38fe74d, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.506, g: 0.549, b: 0.973, a: 1}
    subtitulo: Float do Player
  - texto: ligada == false
    textoAnimator: 
    descricao: "O par\xE2metro Bool ligada vale false: n\xE3o tem ningu\xE9m na sala,
      e o sensor desligou o par\xE2metro."
    setaCorreta: 1
    icone: {fileID: 21300000, guid: 03781f078c9d72d4c83fa5bc56a614db, type: 3}
    moldura: {fileID: 21300000, guid: 137b9efd237877b40ae203e1d3dd3249, type: 3}
    categoria: "PAR\xC2METRO"
    corCategoria: {r: 0.984, g: 0.573, b: 0.235, a: 1}
    subtitulo: Bool do Animator
  - texto: Start()
    textoAnimator: 
    descricao: "M\xE9todo que o Unity chama uma \xFAnica vez, quando o objeto come\xE7a."
    setaCorreta: -1
    icone: {fileID: 21300000, guid: 7526b77a00a003f4190305f1dfe044fd, type: 3}
    moldura: {fileID: 21300000, guid: 41d881d67a6d32f489de2ad88a4a5675, type: 3}
    categoria: "M\xC9TODO"
    corCategoria: {r: 0.639, g: 0.902, b: 0.208, a: 1}
    subtitulo: MonoBehaviour
  titulo: "Configure o Animator da L\xE2mpada"
  fase: "Fase Anima\xE7\xE3o"
  objetivo: 
  tituloDiagrama: "Animator da L\xE2mpada (Base Layer)"
  textoEncaixeVazio: "arraste uma condi\xE7\xE3o"
  descricaoTitulo: "Uma l\xE2mpada com sensor"
  descricaoPadrao: "O sensor da sala muda o par\xE2metro Bool ligada: true quando
    algu\xE9m entra, false quando sai. As setas decidem o que o Animator faz com
    isso. Sem condi\xE7\xE3o nas setas, a l\xE2mpada fica sempre Apagada."
  erroTitulo: "Essa condi\xE7\xE3o n\xE3o serve nessa seta"
  erroTexto: "O Animator da l\xE2mpada foi zerado. Pense: o que precisa ser verdade
    pra l\xE2mpada acender? E pra apagar?"
  concluidoTitulo: "L\xE2mpada configurada!"
  concluidoTexto: "As duas setas t\xEAm condi\xE7\xE3o. Na pr\xE9via, a l\xE2mpada
    acende quando ligada vira true e apaga quando vira false."
  tituloPrevia: "Pr\xE9via"
  rodapeDica: "Passe o mouse numa pe\xE7a pra ler aqui o que ela faz."
  spriteApagada: {fileID: 21300000, guid: 631a7ebf26cf02943bfa2bc6f55e6575, type: 3}
  spriteAcesa: {fileID: 21300000, guid: dcbb12681538aac47849cf9ecd96c04a, type: 3}
  inverterPrevia: 1
  segundosPorFase: 2.2
  sortingOrder: 400
