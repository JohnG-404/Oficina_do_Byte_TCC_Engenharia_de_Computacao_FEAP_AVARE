  corEstatisticas: {r: 0.6039216, g: 0.6392157, b: 0.69803923, a: 1}
  segundosDoAviso: 4
  infoFases:
  - cena: Fisica
    modulo: "F\xEDsica"
    corModulo: {r: 0.2901961, g: 0.54901963, b: 0.96862745, a: 1}
    descricao: "Monte o personagem com f\xEDsica de verdade: andar, pular, cair e
      a c\xE2mera seguindo."
    conceitos:
    - Rigidbody2D
    - Collider2D
    - linearVelocity
    - "C\xE2mera"
  - cena: Aplicacao_Fisica
    modulo: "F\xEDsica"
    corModulo: {r: 0.2901961, g: 0.54901963, b: 0.96862745, a: 1}
    descricao: "Use os componentes de f\xEDsica nos objetos do cen\xE1rio pra abrir
      caminho at\xE9 a sa\xEDda."
    conceitos:
    - Rigidbody2D
    - Collider2D
    - Movimento
    - Pulo
  - cena: Interacao
    modulo: "Intera\xE7\xE3o"
    corModulo: {r: 0.32156864, g: 0.7882353, b: 0.5411765, a: 1}
    descricao: "A\xE7\xE3o e consequ\xEAncia: descubra o que acontece quando o jogador
      encosta, pula em cima ou chega perto."
    conceitos:
    - OnTriggerEnter2D
    - OnCollisionEnter2D
    - Is Trigger
    - Tag Player
  - cena: Interacao_Vida
    modulo: "Intera\xE7\xE3o"
    corModulo: {r: 0.32156864, g: 0.7882353, b: 0.5411765, a: 1}
    descricao: "D\xEA e tire vida do jogador com gatilhos e mostre isso na tela."
    conceitos:
    - OnTriggerEnter2D
    - Evento de vida
    - UI Image
    - Game Over
  - cena: Tutorial_Anim
    modulo: "Anima\xE7\xE3o"
    corModulo: {r: 0.60784316, g: 0.48235294, b: 0.9411765, a: 1}
    descricao: "Coloque os quadros na ordem e acerte a velocidade (FPS) e o loop
      da anima\xE7\xE3o."
    conceitos:
    - Sprites
    - Animation Clip
    - FPS
    - Loop Time
  - cena: Animacao
    modulo: "Anima\xE7\xE3o"
    corModulo: {r: 0.60784316, g: 0.48235294, b: 0.9411765, a: 1}
    descricao: "Monte as transi\xE7\xF5es do Animator com par\xE2metros Bool, Trigger
      e Int."
    conceitos:
    - Animator
    - velocidadeX
    - noChao
    - "Transi\xE7\xF5es"
  - cena: IA
    modulo: IA
    corModulo: {r: 0.9607843, g: 0.77254903, b: 0.25882354, a: 1}
    descricao: "Monte o c\xE9rebro do guarda: estados, transi\xE7\xF5es e a vis\xE3o
      com Raycast."
    conceitos:
    - "M\xE1quina de estados"
    - "Transi\xE7\xF5es"
    - Physics2D.Raycast
    - LayerMask
  - cena: IA_Aplicacao
    modulo: IA
    corModulo: {r: 0.9607843, g: 0.77254903, b: 0.25882354, a: 1}
    descricao: Configure o guarda inimigo e o aliado usando a mesma estrutura de
      IA.
    conceitos:
    - Estados
    - Alvo
    - Raycast
    - Aliado
